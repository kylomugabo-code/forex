# ==================================================
# TRADING
# ==================================================

# ALWAYS START WITH PAPER
TRADING_MODE=paper

# Change to true ONLY after extensive demo testing
ENABLE_LIVE_TRADING=false

# ==================================================
# MT5
# ==================================================

MT5_LOGIN=YOUR_MT5_LOGIN
MT5_PASSWORD=YOUR_MT5_PASSWORD
MT5_SERVER=YOUR_MT5_SERVER

# ==================================================
# FOREX
# ==================================================

SYMBOLS=EURUSD,GBPUSD,USDJPY

TIMEFRAME=M15

# ==================================================
# RISK
# ==================================================

# 0.005 = 0.5%
RISK_PER_TRADE=0.005

# 0.02 = 2%
MAX_DAILY_LOSS=0.02

MAX_OPEN_TRADES=3

MAX_SPREAD_PIPS=2.0

# 2.0 means 2:1 reward/risk
RISK_REWARD=2.0

# ATR stop multiplier
ATR_MULTIPLIER=1.5

# Unique bot identifier
MAGIC_NUMBER=26093001

# ==================================================
# EMERGENCY
# ==================================================

KILL_SWITCH=false
